{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EzraCerpac/HouseAtlas/tools/release/bundle.schema.json",
  "title": "HouseAtlas software-only release bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaSha256",
    "version",
    "source",
    "build",
    "platform",
    "archive",
    "files",
    "frontend",
    "components",
    "preservedComponents",
    "compatibility",
    "runtimeQualification"
  ],
  "properties": {
    "format": {
      "const": "houseatlas.release-bundle.v1"
    },
    "schemaSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "EzraCerpac/HouseAtlas"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workflow",
        "workflowCommit",
        "ref",
        "runId",
        "runAttempt",
        "runner",
        "runnerImage",
        "rust",
        "node",
        "npm",
        "nativeProfileSha256",
        "xcodeBuild"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github-actions",
            "synthetic-fixture"
          ]
        },
        "workflow": {
          "const": ".github/workflows/release-bundle.yml"
        },
        "workflowCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "const": "refs/heads/main"
        },
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "runner": {
          "const": "macos-15-intel"
        },
        "runnerImage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 100
        },
        "rust": {
          "const": "1.99.0"
        },
        "node": {
          "const": "26.10.0"
        },
        "npm": {
          "const": "11.19.1"
        },
        "nativeProfileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "xcodeBuild": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+$"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "target",
        "minimumOs",
        "abi",
        "dynamicLibraries",
        "sdkVersion"
      ],
      "properties": {
        "os": {
          "const": "macos"
        },
        "architecture": {
          "const": "x86_64"
        },
        "target": {
          "const": "x86_64-apple-darwin"
        },
        "minimumOs": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "maxLength": 200
        },
        "abi": {
          "const": "apple-darwin"
        },
        "dynamicLibraries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(usr/lib/|System/Library/)[A-Za-z0-9._/+\\-]+$",
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "sdkVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "format",
        "bytes",
        "unpackedBytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^houseatlas-[0-9a-z.-]+-x86_64-apple-darwin\\.tar\\.gz$",
          "maxLength": 140
        },
        "format": {
          "const": "ustar+gzip"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "unpackedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(bin/houseatlas|frontend/[A-Za-z0-9._/\\-]+|licenses/[A-Za-z0-9._/\\-]+)$",
            "maxLength": 180
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shellBuildSha256",
        "closureSha256"
      ],
      "properties": {
        "shellBuildSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "closureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "frontend"
      ],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "identitySha256",
            "requiredInstalledSha256"
          ],
          "properties": {
            "action": {
              "enum": [
                "replace",
                "retain"
              ]
            },
            "identitySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "requiredInstalledSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "identitySha256",
            "requiredInstalledSha256"
          ],
          "properties": {
            "action": {
              "enum": [
                "replace",
                "retain"
              ]
            },
            "identitySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "requiredInstalledSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "preservedComponents": {
      "const": [
        "updater",
        "configuration",
        "database",
        "access-state",
        "media",
        "models",
        "saved-copies"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backendFrontend",
        "storagePolicy",
        "requiredStorageContractSha256",
        "resultingStorageContractSha256",
        "codeRollbackCompatible"
      ],
      "properties": {
        "status": {
          "enum": [
            "unqualified",
            "reviewed"
          ]
        },
        "backendFrontend": {
          "const": "same-source"
        },
        "storagePolicy": {
          "const": "preserve-no-migration"
        },
        "requiredStorageContractSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "resultingStorageContractSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "codeRollbackCompatible": {
          "type": "boolean"
        }
      }
    },
    "runtimeQualification": {
      "const": "not-established"
    }
  },
  "$defs": {
    "releaseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "native",
        "compatibility"
      ],
      "properties": {
        "format": {
          "const": "houseatlas.release-profile.v1"
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "runner",
            "target",
            "minimumMacos",
            "sourceInputsSha256",
            "allowedDylibs",
            "runnerImage",
            "sdkVersion",
            "xcodeBuild"
          ],
          "properties": {
            "status": {
              "enum": [
                "unqualified",
                "reviewed"
              ]
            },
            "runner": {
              "const": "macos-15-intel"
            },
            "target": {
              "const": "x86_64-apple-darwin"
            },
            "minimumMacos": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "sourceInputsSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "allowedDylibs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/(usr/lib/|System/Library/)[A-Za-z0-9._/+\\-]+$",
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true
            },
            "runnerImage": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9._-]+$",
              "maxLength": 100
            },
            "sdkVersion": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
            },
            "xcodeBuild": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9]+$"
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "backendFrontend",
            "storagePolicy",
            "requiredStorageContractSha256",
            "resultingStorageContractSha256",
            "codeRollbackCompatible"
          ],
          "properties": {
            "status": {
              "enum": [
                "unqualified",
                "reviewed"
              ]
            },
            "backendFrontend": {
              "const": "same-source"
            },
            "storagePolicy": {
              "const": "preserve-no-migration"
            },
            "requiredStorageContractSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "resultingStorageContractSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "codeRollbackCompatible": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
