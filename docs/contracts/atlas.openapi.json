{
  "openapi": "3.1.0",
  "info": {
    "title": "HouseAtlas AT-02 API contract",
    "version": "1.0.0",
    "description": "Synthetic contract; no deployed origin. Viewer can read authorized homes, editor can mutate Atlas-owned records. HomeBox editing uses native links."
  },
  "security": [
    {
      "atlasSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "atlasSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "atlas_session",
        "description": "Placeholder wire name; actual secure session lifecycle is AT-11. Mutation CSRF/Origin validation is mandatory."
      }
    }
  },
  "paths": {
    "/api/atlas/v1/workspaces/{workspaceId}/homes/{homeId}/records/{recordType}/{recordId}": {
      "get": {
        "operationId": "getAtlasRecord",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "homeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "recordType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "identity",
                "binding",
                "evidence",
                "location-semantics",
                "circuit",
                "valve",
                "relation",
                "geometry",
                "asset",
                "reconciliation"
              ]
            }
          },
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped versioned record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../packages/contracts/schemas/atlas.schema.json#/$defs/record"
                }
              }
            }
          },
          "401": {
            "description": "No authorized session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../packages/contracts/schemas/atlas.schema.json#/$defs/apiError"
                }
              }
            }
          },
          "403": {
            "description": "Viewer/editor or source policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../packages/contracts/schemas/atlas.schema.json#/$defs/apiError"
                }
              }
            }
          },
          "404": {
            "description": "Not found in authorized home; no foreign-home detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../packages/contracts/schemas/atlas.schema.json#/$defs/apiError"
                }
              }
            }
          }
        }
      }
    },
